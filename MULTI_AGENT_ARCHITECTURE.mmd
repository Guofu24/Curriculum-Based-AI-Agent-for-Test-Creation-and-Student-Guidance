flowchart TD
  Teacher["Teacher / Frontend"] --> GenerateAPI["POST /api/v1/generate/exam"]
  GenerateAPI --> CreateExam["ExamService.create_exam()"]
  CreateExam --> BG["asyncio.create_task(background_generation)"]
  BG --> Orchestrator["OrchestratorAgent.generate_exam()"]
  Orchestrator --> Graph["LangGraph StateGraph<br/>thread_id = exam_id"]

  Graph -. checkpoint state .-> Checkpointer[("LangGraph checkpointer<br/>AsyncPostgresSaver preferred<br/>MemorySaver fallback")]
  Graph -. realtime events .-> WS["WebSocket /ws/exam/{exam_id}"]
  WS --> LiveViewer["GenerationLiveViewer"]

  subgraph GraphFlow["Compiled graph in backend/app/agents/graph/builder.py"]
    Start(("START")) --> Init["initialize<br/>normalize initial ExamGraphState"]
    Init --> Clarify{"clarification_check<br/>requirements clear?"}
    Clarify -- "no" --> EmitClarify["emit_clarification<br/>event: clarification_needed"]
    EmitClarify --> StopClarify(("END / waits for external fix-resume path"))

    Clarify -- "yes" --> LTM["load_long_term_memory<br/>LongTermMemory(Postgres)"]
    LTM --> Decide{"decide_plan<br/>simple or complex?"}

    Decide -- "simple" --> Retrieve["RetrievalAgent<br/>retrieve_knowledge"]
    Decide -- "complex" --> Fanout["fanout_complex"]
    Fanout --> Planner["PlannerAgent<br/>plan_complex"]
    Fanout --> Retrieve

    Planner --> Merge["merge_plan_retrieval<br/>join plan + retrieval"]
    Retrieve --> RetrieveOK{"retrieval status<br/>success or partial?"}
    RetrieveOK -- "failed" --> RetrievalFail["handle_retrieval_failure<br/>continue with degraded context"]
    RetrieveOK -- "ok" --> Merge

    Retrieve -. "coverage_report" .-> MsgBus[("Redis AgentMessageBus")]
    Retrieve -. "chunks / coverage" .-> Pinecone[("Pinecone vectors<br/>document namespace or textbook namespace")]
    Retrieve -. "weak chapters" .-> TaskQueue["task_queue<br/>focused_retrieval"]

    Merge --> Dispatch["dispatch_tasks<br/>optional focused_retrieval"]
    TaskQueue --> Dispatch
    RetrievalFail --> Outline
    Dispatch --> Outline["OutlineAgent<br/>create_outline"]
    MsgBus -. "coverage hints" .-> Outline

    Outline --> OutlineOK{"outline status<br/>success or partial?"}
    OutlineOK -- "failed" --> OutlineFail["handle_outline_failure"]
    OutlineFail --> EndFail1(("END"))
    OutlineOK -- "ok" --> CP1["emit_checkpoint_1<br/>HITL blueprint review"]
    CP1 --> WaitCP1["wait_for_blueprint_approval<br/>LangGraph interrupt()"]

    WaitCP1 -- "approve via Command(resume)" --> Builder["BuilderAgent<br/>build_questions"]
    WaitCP1 -- "reject + feedback" --> Outline
    WaitCP1 -- "timeout" --> Timeout["handle_timeout"]
    WaitCP1 -- "pending" --> EndPaused1(("END paused until HTTP resume"))

    Builder --> BuildOK{"builder status<br/>success or partial?"}
    BuildOK -- "failed" --> BuilderFail["handle_builder_failure"]
    BuilderFail --> CP2
    BuildOK -- "ok" --> Validator["ValidatorAgent<br/>validate_questions"]

    Validator -. "targeted_rebuild" .-> MsgBus
    MsgBus -. "correction strategies" .-> Builder
    Validator --> Skills["Validation skills<br/>Bloom classifier<br/>Scope checker<br/>Dedup / difficulty / answer checks"]
    Validator --> CheckValidation["check_validation_result"]
    CheckValidation --> Valid{"validation passed?"}
    Valid -- "yes" --> CP2["emit_checkpoint_2<br/>HITL full exam review"]
    Valid -- "no, retry_count < 3" --> Retry["retry_builder<br/>increment retry_count"]
    Retry --> Builder
    Valid -- "no, max retries" --> MaxRetry["handle_max_retries_exceeded"]
    MaxRetry --> CP2

    CP2 --> WaitCP2["wait_for_review<br/>LangGraph interrupt()"]
    WaitCP2 -- "approve via Command(resume)" --> SavePrefs["save_teacher_preferences<br/>LongTermMemory"]
    WaitCP2 -- "reject + feedback" --> FinalFeedback["finalize_with_feedback<br/>record rejection"]
    WaitCP2 -- "timeout" --> Timeout
    SavePrefs --> CP3["emit_checkpoint_3<br/>export preview"]
    CP3 --> Finalize["finalize_output<br/>emit completed"]
    Finalize --> Done(("END completed"))
    FinalFeedback --> EndRejected(("END failed"))
    Timeout --> EndTimeout(("END failed"))
  end

  LiveViewer -- "approve / reject blueprint" --> ApproveCP1["POST /api/v1/exams/{exam_id}/approve-blueprint<br/>or reject-blueprint"]
  ApproveCP1 --> ResumeCP1["graph.ainvoke(Command(resume=...))"]
  ResumeCP1 --> WaitCP1

  LiveViewer -- "approve / reject final exam" --> ApproveCP2["POST /api/v1/exams/{exam_id}/submit-review"]
  ApproveCP2 --> ResumeCP2["graph.ainvoke(Command(resume=...))"]
  ResumeCP2 --> WaitCP2

  Finalize --> Persist["ExamService.update_questions()<br/>questions, blueprint, history"]
  Persist --> Postgres[("PostgreSQL")]
  SavePrefs --> Postgres
  CreateExam --> Postgres
  CP3 --> Export["GET /api/v1/exams/{exam_id}/export/pdf<br/>GET /api/v1/exams/{exam_id}/export/docx"]

  classDef external fill:#eef6ff,stroke:#2563eb,color:#0f172a
  classDef api fill:#f8fafc,stroke:#64748b,color:#0f172a
  classDef agent fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef hitl fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef store fill:#f5f3ff,stroke:#7c3aed,color:#2e1065
  classDef terminal fill:#fee2e2,stroke:#dc2626,color:#7f1d1d

  class Teacher,LiveViewer external
  class GenerateAPI,ApproveCP1,ApproveCP2,ResumeCP1,ResumeCP2,CreateExam,BG,Orchestrator,Graph,Export,Persist api
  class LTM,Planner,Retrieve,Merge,Dispatch,Outline,Builder,Validator,Skills,Retry,SavePrefs,Finalize,FinalFeedback agent
  class CP1,WaitCP1,CP2,WaitCP2,CP3,EmitClarify hitl
  class Checkpointer,WS,MsgBus,Pinecone,Postgres,TaskQueue store
  class StopClarify,EndFail1,EndPaused1,Done,EndRejected,EndTimeout,Timeout,OutlineFail,BuilderFail,MaxRetry terminal
