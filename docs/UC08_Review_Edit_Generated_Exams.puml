@startuml UC08_Review_Edit_Generated_Exams
!theme plain
title UC08 - Review and Edit Generated Exams

actor "Teacher" as USER
participant "Frontend" as FE
participant "WS Client" as WS
participant "FastAPI exams_router" as ROUTE
participant "OrchestratorAgent" as ORCH
participant "ExamService" as SVC
participant "ExamExporter" as EXP
database "PostgreSQL" as DB

note over USER, ROUTE : Begins when HITL Checkpoint 2 is active\n(after question generation + validation)

alt Load review data
  FE -> ROUTE : GET /api/v1/exams/{id}/review-data
  ROUTE -> ORCH : get_question_review_data(exam_id)
  ORCH -> DB : SELECT exams.questions + cost_report
  ROUTE -> FE : {questions[], quality_scores, cost_report}
  FE -> USER : Display all questions + quality indicators\n+ validation warnings + source evidence
end

alt Preview exam
  USER -> FE : Click Preview
  FE -> ROUTE : GET /api/v1/exams/{id}/preview
  ROUTE -> EXP : ExamExporter._render_html()\n(teacher version: answers + rubric + blueprint)
  ROUTE -> FE : HTML
  FE -> USER : Show preview in modal/tab
end

alt Direct question edit
  USER -> FE : Click Edit on a question
  FE -> USER : Show edit form (content, options, rubric, Bloom level)
  USER -> FE : Modify fields
  USER -> FE : Click Save
  FE -> ROUTE : PATCH /api/v1/exams/{id}/questions/{q_id}
  ROUTE -> SVC : update_question(exam_id, q_id, patch_data)
  SVC -> DB : UPDATE exams.questions JSONB
  alt Save fails
    SVC -> FE : 500 Error
    FE -> USER : Error "Failed to save changes" + keep previous data
  end
  SVC -> FE : Updated QuestionResponse
  FE -> USER : Update question in list
end

alt AI edit prompt
  USER -> FE : Enter instruction: "Thay doi 3 cau dau thanh van_dung_cao"
  USER -> FE : Click Apply AI Edit
  FE -> ROUTE : POST /api/v1/exams/{id}/edit-prompt
  ROUTE -> ORCH : edit_via_llm(exam_id, natural_language)
  alt AI edit fails
    ROUTE -> FE : 500 Error
    FE -> USER : Error "AI edit failed" + keep current content
  end
  ORCH -> DB : UPDATE exams.questions
  ORCH -> FE : Updated exam
  FE -> USER : Display updated questions
end

alt Whole-exam regeneration
  USER -> FE : Click "Regenerate All"
  FE -> USER : Show confirmation dialog
  USER -> FE : Confirm
  FE -> ROUTE : POST /api/v1/exams/{id}/regenerate
  ROUTE -> DB : UPDATE exams SET status=regenerating
  ROUTE -> FE : 202 Accepted
  FE -> USER : Display "Regenerating..." state
  note over ORCH : Full pipeline re-runs (UC06 -> UC07 -> UC08)
end

alt Submit review (approve)
  USER -> FE : Click Approve / Publish
  FE -> ROUTE : POST /api/v1/exams/{id}/submit-review\n(approved:true)
  ROUTE -> ORCH : submit_review(approved:true)
  ORCH -> DB : UPDATE exams SET status=published\n+ cost_report + questions JSONB
  ORCH -> FE : 200 OK
  FE -> USER : Display "Exam published!" + redirect to exam detail
end

alt Submit review (reject)
  USER -> FE : Click Reject + enter feedback
  FE -> ROUTE : POST /api/v1/exams/{id}/submit-review\n(approved:false, feedback)
  ROUTE -> ORCH : submit_review(approved:false, feedback)
  ORCH -> DB : UPDATE exams SET status=regenerating
  ORCH -> FE : 202 Accepted
  FE -> USER : Display "Regeneration requested"
  note over ORCH : Celery task re-runs pipeline
end
@enduml
