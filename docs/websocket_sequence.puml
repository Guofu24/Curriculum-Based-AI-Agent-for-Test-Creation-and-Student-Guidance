@startuml WebSocket_Sequence
!theme plain
skinparam maxMessageSize 300
skinparam nodesep 30
skinparam ranksep 60

title WebSocket Event Flow (G19)

actor "Giao vien" as USER

participant "Frontend Next.js" as FE
participant "WS Client (api.ts)" as WS
participant "FastAPI generate_router" as ROUTE
participant "FastAPI Background Task" as BG
participant "OrchestratorAgent" as ORCH
participant "LangGraph build_exam_graph" as GRAPH
participant "emit_checkpoint_1 node" as EMIT1
participant "wait_for_blueprint_approval (interrupt)" as WAIT1
participant "emit_checkpoint_2 node" as EMIT2
participant "ConnectionManager (ws/manager.py)" as MGR
database "Redis" as REDIS
database "PostgreSQL exams" as DB

group Khởi tạo generation
  USER -> FE : Submit tao de (scope, Bloom, config)
  FE -> ROUTE : POST /api/v1/generate/exam
  ROUTE -> ROUTE : Validate bloom sum = 100%
  ROUTE -> ROUTE : Rate limit check
  ROUTE -> DB : Create exam row (exam_config JSONB)
  ROUTE -> FE : Response immediately {exam_id, ws_url}
  ROUTE -> BG : asyncio.create_task(_background_generation())
  FE -> WS : new WebSocket(ws_url)
  WS -> MGR : connect(websocket, exam_id)
  MGR -> REDIS : LRANGE ws_events:{exam_id}
  MGR -> WS : Replay stored events
end

group Retrieval + Outline
  BG -> ORCH : generate_exam(exam_id, config)
  ORCH -> GRAPH : ainvoke(initial_state)
  GRAPH -> GRAPH : initialize state
  GRAPH -> GRAPH : clarification_check
  GRAPH -> GRAPH : load_long_term_memory
  GRAPH -> GRAPH : decide_plan
  GRAPH -> GRAPH : retrieve_knowledge (Retrieval Agent)
  ORCH -> REDIS : EmbeddingService (cache check)
  REDIS -> ORCH : cached or new embed
  ORCH -> REDIS : Pinecone query per chapter namespace
  REDIS -> ORCH : retrieved_chunks
  ORCH -> REDIS : CrossEncoder rerank (top-8 per chapter)
  GRAPH -> GRAPH : create_outline (Outline Agent)
  ORCH -> ORCH : LLM generates blueprint slots
end

group HITL Checkpoint 1 - Blueprint Review
  GRAPH -> EMIT1 : emit_checkpoint_1()
  EMIT1 -> MGR : emit(type:hitl_checkpoint, checkpoint_id:1, data:{blueprint})
  MGR -> WS : send_json event
  MGR -> REDIS : LPUSH ws_events:{exam_id}
  MGR -> REDIS : PUBLISH exam:{exam_id}
  WS -> USER : Display blueprint (chart Bloom x Chapter)
  USER -> FE : Click Approve hoac Reject

  GRAPH -> WAIT1 : langgraph.types.interrupt() -> Graph PAUSED

  alt Approved
    USER -> FE : Click "Approve Blueprint"
    FE -> ROUTE : POST /approve-blueprint
    ROUTE -> ORCH : approve_blueprint(exam_id)
    ORCH -> REDIS : SET hitl:approved:{exam_id}:1 "true"
    ORCH -> WAIT1 : unblock
    WAIT1 -> GRAPH : resume from interrupt
  else Rejected
    USER -> FE : Click "Reject" + feedback
    FE -> ROUTE : POST /reject-blueprint
    ROUTE -> ORCH : reject_blueprint(exam_id, feedback)
    ORCH -> ORCH : Re-run create_outline with feedback (G8)
    ORCH -> MGR : emit new blueprint
    MGR -> WS : Updated hitl_checkpoint_1
  end
end

group Build + Validate (retry loop)
  GRAPH -> GRAPH : build_questions (Builder Agent)
  ORCH -> ORCH : Generate in chunks (5/concurrent)
  ORCH -> ORCH : Per-slot: Bloom template + SerpAPI + guardrails
  ORCH -> ORCH : JSON sanitize + parse (3 layers)
  ORCH -> MGR : question_generated event (per question)
  MGR -> WS : Per-question streaming
  GRAPH -> GRAPH : validate_questions (Validator Agent)
  ORCH -> ORCH : Batch validation (10/batch, not 1/call)
  ORCH -> ORCH : 3 checks: answer, Bloom, scope
  ORCH -> MGR : validation_result event

  alt Validation passed
    GRAPH -> GRAPH : check_validation_result -> emit_checkpoint_2
  else Validation failed + retry < 3
    GRAPH -> GRAPH : retry_builder -> build_questions
    ORCH -> REDIS : Save retry_issues:{exam_id}
  else Max retries exceeded
    GRAPH -> GRAPH : handle_max_retries_exceeded -> emit_checkpoint_2
  end
end

group HITL Checkpoint 2 - Full Review
  GRAPH -> EMIT2 : emit_checkpoint_2()
  EMIT2 -> MGR : emit(type:hitl_checkpoint, checkpoint_id:2, data:{questions})
  MGR -> WS : send_json
  MGR -> REDIS : LPUSH + PUBLISH
  WS -> USER : Display full exam + Bloom chart + edit options
  USER -> FE : Click Publish hoac Edit + Reject

  GRAPH -> GRAPH : wait_for_review (interrupt -> PAUSED)

  alt Approved
    USER -> FE : Click "Publish"
    FE -> ROUTE : POST /submit-review (approved:true)
    ROUTE -> ORCH : submit_review(approved:true)
    ORCH -> ORCH : save_teacher_preferences -> PostgreSQL
    ORCH -> DB : Update exam row (questions JSONB + cost_report)
    ORCH -> MGR : completed event
    MGR -> WS : completed
    WS -> USER : Exam ready
  else Rejected / Edit
    USER -> FE : Edit questions + Reject
    FE -> ROUTE : POST /submit-review (approved:false, feedback)
    ROUTE -> ORCH : submit_review(approved:false)
    ORCH -> ORCH : Dispatch Celery task for regeneration
    ORCH -> MGR : Status: regenerating
    MGR -> WS : regenerating event
  end
end

group Reconnect - Event Replay (G19)
  USER -> WS : Close browser tab
  WS -> MGR : disconnect(websocket, exam_id)
  note over MGR : Connection removed from active list
  USER -> FE : Reopen page
  FE -> WS : new WebSocket(ws_url)
  WS -> MGR : connect(websocket, exam_id)
  MGR -> REDIS : LRANGE ws_events:{exam_id}
  REDIS -> MGR : Full event history
  MGR -> WS : Replay ALL events
  WS -> USER : Catches up instantly - no lost events
end

@enduml
