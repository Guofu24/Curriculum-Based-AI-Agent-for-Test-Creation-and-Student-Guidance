@startuml UC01_Sign_Up
!theme plain
title UC01 - Sign Up

actor "User" as USER
participant "Frontend" as FE
participant "FastAPI auth_router" as ROUTE
participant "AuthService" as SVC
database "PostgreSQL" as DB

USER -> FE : Open auth page -> Register tab
FE -> USER : Display registration form\n(full name, email, password)
USER -> FE : Enter full name, email, password
FE -> USER : Validate: password >= 8 chars?
alt Password < 8 chars
  FE -> USER : Display error "Password must be at least 8 characters"
  USER -> FE : Re-enter password
end
USER -> FE : Click Register
FE -> ROUTE : POST /api/v1/auth/register
ROUTE -> SVC : register(email, password, full_name)
SVC -> SVC : bcrypt.hash(password)
SVC -> DB : INSERT users (email, password_hash, full_name, role=teacher)
alt Email already exists
  DB -> SVC : IntegrityError
  SVC -> FE : 400 Email already registered
  FE -> USER : Display error "Email already registered"
end
SVC -> FE : 201 UserResponse
FE -> USER : Display success "Registration successful! Please log in."
@enduml
