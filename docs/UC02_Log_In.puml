@startuml UC02_Log_In
!theme plain
title UC02 - Log In

actor "Teacher" as USER
participant "Frontend" as FE
participant "FastAPI auth_router" as ROUTE
participant "AuthService" as SVC
database "PostgreSQL" as DB
database "Redis" as REDIS

USER -> FE : Open auth page -> Login tab
FE -> USER : Display login form (email, password)
USER -> FE : Enter email and password
USER -> FE : Click Login
FE -> ROUTE : POST /api/v1/auth/login

ROUTE -> SVC : login(email, password, ip)
SVC -> REDIS : incr_rate_limit(login:{ip})
REDIS -> SVC : attempt count
alt Too many attempts (rate limit exceeded)
  SVC -> FE : 429 "Too many login attempts"
  FE -> USER : Display error + retry after wait
end

SVC -> DB : SELECT users WHERE email
alt Email not found
  DB -> SVC : None
  SVC -> FE : 401 "Invalid email or password"
  FE -> USER : Display error message
end
SVC -> SVC : bcrypt.verify(password, hash)
alt Wrong password
  SVC -> FE : 401 "Invalid email or password"
  FE -> USER : Display error "Invalid credentials, please try again"
end
SVC -> SVC : generate JWT access_token (15min) + refresh_token (7days)
SVC -> DB : INSERT refresh_tokens (SHA256 hash of token)
SVC -> FE : {access_token, refresh_token, token_type:bearer, expires_in:900}
FE -> FE : Store tokens in localStorage/cookie
FE -> ROUTE : GET /api/v1/auth/me
ROUTE -> DB : SELECT users WHERE id (from JWT)
DB -> FE : UserResponse (full_name, email, role, created_at)
FE -> USER : Redirect to Dashboard
@enduml
