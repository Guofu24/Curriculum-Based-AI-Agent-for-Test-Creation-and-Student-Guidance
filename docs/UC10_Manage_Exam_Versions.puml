@startuml UC10_Manage_Exam_Versions
!theme plain
title UC10 - Manage Exam Versions

actor "Teacher" as USER
participant "Frontend" as FE
participant "FastAPI exams_router" as ROUTE
participant "ExamService" as SVC
database "PostgreSQL" as DB

alt View version history
  USER -> FE : Open exam detail -> History tab
  FE -> ROUTE : GET /api/v1/exams/{id}/history
  ROUTE -> DB : SELECT exam_history WHERE exam_id\nORDER BY created_at DESC
  DB -> ROUTE : All snapshots
  alt No history exists
    DB -> FE : Empty list
    FE -> USER : Display empty-state "No version history available"
  end
  ROUTE -> FE : ExamHistoryResponse[]\n(timestamps, change_type, change_description)
  FE -> USER : Display version timeline with descriptions
end

alt View specific version
  USER -> FE : Click a version entry
  FE -> ROUTE : GET /api/v1/exams/{id}/versions
  ROUTE -> DB : SELECT exam_history WHERE id
  DB -> ROUTE : Full snapshot JSONB
  ROUTE -> FE : Snapshot state
  FE -> USER : Display historical exam content (read-only)
end

alt Restore version
  USER -> FE : Click Restore on a version
  FE -> USER : Show confirmation dialog
  USER -> FE : Cancel
  FE -> USER : Dismiss dialog, current version kept

  USER -> FE : Click Restore -> Confirm
  FE -> ROUTE : POST /api/v1/exams/{id}/history/{version_id}/restore
  ROUTE -> SVC : restore_version(exam_id, history_id)
  SVC -> DB : SELECT exam_history WHERE id
  SVC -> DB : UPDATE exams SET questions = snapshot.questions
  SVC -> DB : INSERT exam_history\n(change_type=restore, snapshot=current_state)
  alt Restore fails
    SVC -> FE : 500 Error
    FE -> USER : Error "Restore failed" + current version unchanged
  end
  SVC -> FE : Restored exam
  FE -> USER : Reload current exam data + history
  FE -> USER : Display success "Version restored"
end
@enduml
