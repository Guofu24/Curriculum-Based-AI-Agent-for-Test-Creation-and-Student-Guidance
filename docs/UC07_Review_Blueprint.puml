@startuml UC07_Review_Blueprint
!theme plain
title UC07 - Review Blueprint

actor "Teacher" as USER
participant "Frontend" as FE
participant "WS Client" as WS
participant "FastAPI exams_router" as ROUTE
participant "OrchestratorAgent" as ORCH
database "PostgreSQL" as DB
database "Redis" as REDIS
participant "ConnectionManager" as MGR

note over USER, ROUTE : This use case begins when generation\nreaches HITL Checkpoint 1 (after outline phase)

alt Blueprint not yet available
  USER -> FE : Open live generation screen
  FE -> WS : Listen for hitl_checkpoint events
  WS -> USER : Wait for hitl_checkpoint type=blueprint
  USER -> USER : Checkpoint 1 pending...
end

FE -> ROUTE : GET /api/v1/exams/{id}/review-data
ROUTE -> ORCH : get_blueprint_review_data(exam_id)
ORCH -> DB : Load blueprint + distribution_summary
ROUTE -> FE : {blueprint[], distribution_summary}
FE -> USER : Display blueprint review screen:\n- Scope coverage chart\n- Bloom distribution x Chapter table\n- Slot preview (question_id, bloom, chapter, topic)

alt Approve blueprint
  USER -> FE : Click Approve
  FE -> ROUTE : POST /api/v1/exams/{id}/approve-blueprint
  ROUTE -> ORCH : approve_blueprint(exam_id)
  ORCH -> REDIS : SET hitl:approved:{exam_id}:1 "true"
  ORCH -> MGR : emit blueprint_approved event
  MGR -> WS : send_json
  WS -> USER : Display "Blueprint approved - generating questions..."
  note over ORCH : Pipeline resumes -> BuilderAgent begins
  note over USER : UC08 Review and Edit Generated Exams\n(HITL Checkpoint 2)
end

alt Reject blueprint with feedback
  USER -> FE : Click Reject
  FE -> USER : Show feedback input dialog
  USER -> FE : Enter rejection feedback (min 5 chars)
  alt Feedback < 5 chars
    FE -> USER : Error "Feedback must be at least 5 characters"
  end
  USER -> FE : Submit rejection
  FE -> ROUTE : POST /api/v1/exams/{id}/reject-blueprint
  ROUTE -> ORCH : reject_blueprint(exam_id, feedback)
  ORCH -> ORCH : Re-run OutlineAgent with feedback (G8)
  ORCH -> MGR : emit new hitl_checkpoint_1
  MGR -> WS : Updated blueprint
  WS -> USER : Display new blueprint for review
  note over ORCH : Wait for next review cycle\n(steps 2-5 repeat)
end
@enduml
