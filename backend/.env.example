# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/curriculum_ai

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ============================================================
# LLM PROVIDER CONFIG
# Chọn 1 trong: openai | openrouter | groq | g4f | ollama | anthropic
# ============================================================
LLM_PROVIDER=groq

# Fallback chain — thử theo thứ tự nếu primary fail
# Để trống để tắt fallback
LLM_FALLBACK_CHAIN=groq,g4f

# ============================================================
# MODEL ROUTING — tên model theo provider đang dùng
# ============================================================
# Model mạnh: dùng cho Orchestrator, Builder, Validator answer checking
LLM_MODEL_STRONG=llama-3.3-70b-versatile

# Model nhẹ: dùng cho Planner, Reranker, Outline, Dedup, Skills
LLM_MODEL_LIGHT=llama-3.1-8b-instant

# Model vision: dùng cho image description trong RAG extractor
LLM_MODEL_VISION=llama-3.2-11b-vision-preview

# ============================================================
# API KEYS THEO PROVIDER
# ============================================================

# OpenAI (nếu dùng provider=openai)
OPENAI_API_KEY=sk-...

# OpenRouter — 1 key dùng được 200+ models
# Đăng ký: https://openrouter.ai — có free credits
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_APP_NAME=curriculum-ai-agent

# Groq — inference rất nhanh, free tier 14,400 req/ngày
# Đăng ký: https://console.groq.com — không cần thẻ
GROQ_API_KEY=gsk_...

# Anthropic Claude
# Đăng ký: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Ollama — local, không cần key
# Cài: https://ollama.ai — chạy model hoàn toàn offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_STRONG=llama3.2
OLLAMA_MODEL_LIGHT=llama3.2

# g4f / FreeGPT — không cần key, dùng reverse engineering
# Chỉ dùng cho dev/test, không production
# ============================================================

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=curriculum-ai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=curriculum-ai-uploads

# MathPix (formula OCR)
MATHPIX_APP_ID=your-mathpix-app-id
MATHPIX_APP_KEY=your-mathpix-app-key

# Search (Builder Agent - van_dung_cao)
SERPAPI_KEY=your-serpapi-key

# LangFuse (Observability)
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://7034-42-118-79-158.ngrok-free.app
