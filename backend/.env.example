# =========================================
# ExamAI Backend - Environment Configuration
# =========================================

# --- Application ---
APP_NAME=ExamAI
APP_ENV=development
DEBUG=true
SECRET_KEY=GUOFU24
API_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://examai:examai@localhost:5432/examai

# --- LLM Provider ---
# Choose: openai, anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embedding ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# For local: sentence-transformers/all-MiniLM-L6-v2

# --- Pinecone (Free Tier — cloud vector DB) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=examai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
