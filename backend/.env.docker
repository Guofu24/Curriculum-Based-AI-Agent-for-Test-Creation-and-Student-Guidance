# Docker Compose environment — copy from .env.example and fill in values
# DATABASE_URL uses Docker service name 'postgres' instead of localhost
DATABASE_URL=postgresql+asyncpg://examai:examai@postgres:5432/examai

# Redis uses Docker service name 'redis'
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=curriculum-ai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# JWT
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LangFuse (Observability)
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000